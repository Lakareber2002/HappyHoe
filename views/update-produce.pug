doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Edit Produce
    link(rel="stylesheet" href="/css/form.css")  

  body
    h2 Edit Produce Details
    form(action="/edit-produce/" + produce._id method="POST")

      select(name="producename")
        option(value="" disabled selected) Select produce
        option(value="Beans" selected=produce.producename === "Beans") Beans
        option(value="CowPeas" selected=produce.producename === "CowPeas") Cow Peas 
        option(value="GrainMaize" selected=produce.producename === "GrainMaize") Grain Maize
        option(value="Peas" selected=produce.producename === "Peas") Peas
        option(value="GroundNuts" selected=produce.producename === "GroundNuts") Ground Nuts
        option(value="SoyaBeans" selected=produce.producename === "SoyaBeans") Soya Beans

      input(type="text" name="producetype" placeholder="Produce Type" value=produce.produceType)
      select(name="producetype")
        option(value="" disabled selected) Select produce type
        option(value="legumes" selected=produce.producetype === "legumes") Legumes
        option(value="Grains" selected=produce.producetype === "Grains") Grains

      input(type="text" name="date" placeholder="Date" value=produce.date)
      input(type="text" name="time" placeholder="Time" value=produce.time)

      input(type="number" name="tonnage" placeholder="Tonnage (in metric tons)" value=produce.tonnage)

      input(type="text" name="source" placeholder="Source of produce" value=produce.source)
      select(name="source")
        option(value="" disabled selected) Select produce source
        option(value="localFarms" selected=produce.source === "localFarms") Local Farms
        option(value="dealers" selected=produce.source === "dealers") Dealers
        option(value="matugaFarm" selected=produce.source === "matugaFarm") Matuga Farm
        option(value="maganjoFarm" selected=produce.source === "maganjoFarm") Maganjo Farm
        option(value="otherCompanies" selected=produce.source === "otherCompanies") Other Companies

      input(type="number" name="cost" placeholder="Cost" value=produce.cost)
      input(type="text" name="dealers" placeholder="Dealers" value=produce.dealers)

      select(name="branch")
        option(value="" disabled selected) Select Branch
        option(value="maganjo" selected=produce.branch === "maganjo") Maganjo
        option(value="matuga" selected=produce.branch === "matuga") Matuga

      input(type="text" name="contact" placeholder="Contact" value=produce.contact)
      input(type="text" name="price" placeholder="Price to be Sold At" value=produce.price)

      input(type="submit" value="Save Changes")

    a(href="/produce-list-page") Go Back To Stock List Page.
