doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Credit Records List
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='/css/table.css')
  body
    // Navbar with Logo
    nav.navbar.navbar-expand-lg.navbar-light.bg-light
      .container-fluid
        // Logo and Brand Name
        a.navbar-brand(href='/')
          img(src='/image/pl.png' alt='Logo' width='50' height='50' class='d-inline-block align-text-top')
          | Credit Management
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav', aria-controls='navbarNav', aria-expanded='false', aria-label='Toggle navigation')
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav
            li.nav-item
              a.nav-link.active(aria-current='page', href='/dashboard') Dashboard
            li.nav-item
              a.nav-link(href='/Credit') Add Credit
            li.nav-item
              a.nav-link(href='/creditsList') Credit List

    .container
      h2 Credit Records List

      if credits.length
        table.table.table-striped
          thead
            tr
              th Produce Name
              th Produce Type
              th Produce Price
              th Date
              th Due Date
              th Time
              th Tonnage
              th Customer Name
              th Customer Location
              th Customer Contact
              th Branch
              th Edit
              th Delete
          tbody
            each credit in credits
              tr
                td #{credit.producename}
                td #{credit.produceType}
                td #{credit.producePrice}
                td #{credit.produceDate}
                td #{credit.dueDate}
                td #{credit.produceTime}
                td #{credit.produceTonnage}
                td #{credit.customerName}
                td #{credit.customerLocation}
                td #{credit.customerContact}
                td #{credit.branch}
                td
                  a(href=`/update-credit/${credit._id}`) Edit
                td
                  form(action=`/delete-credit/${credit._id}`, method='POST')
                    button(type='submit') Delete
      else
        p No credit records available at the moment.

      // Add a link to go back to the credit form
      a(href='/Credit') Add New Credit Record
      br
      a(href='/dashboard') Back to Dashboard

    // Bootstrap JS (add at the end of the body)
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js')
